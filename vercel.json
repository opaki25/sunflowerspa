{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sunflowerspa.vercel.app"
        }
      ],
      "destination": "https://www.sunflowerwellnessspa.com/:path*",
      "permanent": true
    }
  ]
}
